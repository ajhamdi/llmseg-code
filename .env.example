# Copy to .env and fill in ONE (or more) of the provider keys. Never commit .env.
GEMINI_API_KEY=          # https://aistudio.google.com/apikey        -> --model gemini-3.7-flash
OPENROUTER_API_KEY=      # https://openrouter.ai/keys                -> --model google/gemini-3.7-flash
ANTHROPIC_API_KEY=       # https://console.anthropic.com             -> --model claude-sonnet-5-5
OPENAI_API_KEY=          # https://platform.openai.com/api-keys      -> --model gpt-5.6-terra

# Only for downloading some benchmarks
HF_TOKEN=                # SA-Co/Gold annotations (gated on Hugging Face)
ROBOFLOW_API_KEY=        # SA-Co images, RF-100VL

# Optional locations (defaults: ./data/benchmarks and ./results)
# LLMSEG_DATA=/path/to/benchmarks
# LLMSEG_RESULTS=/path/to/results
